# =============================================================================
# EquityFlow — Environment Variables
# =============================================================================
# COPY this file to .env and fill in your real values.
# NEVER commit .env to Git — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# App Settings
# -----------------------------------------------------------------------------
APP_NAME=EquityFlow
APP_ENV=local
# APP_ENV options: local | production

# -----------------------------------------------------------------------------
# Database (XAMPP defaults shown)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=equityflow
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# -----------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
#
# How to get these:
#  1. Go to https://console.cloud.google.com/
#  2. Create or open a project
#  3. Navigate to: APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#  4. Application type: Web application
#  5. Add Authorised redirect URI:
#       http://localhost/EquityFlow/index.php?page=google-callback
#  6. Copy the Client ID and Client Secret below
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost/EquityFlow/index.php?page=google-callback

# -----------------------------------------------------------------------------
# Session Security
# -----------------------------------------------------------------------------
SESSION_TIMEOUT=1800
MAX_FAILED_ATTEMPTS=5
LOCKOUT_TIME=900
